<?xml version='1.0' encoding='utf-8'?>
<plugin
        id="cordova-plugin-rustore-pay"
        version="0.0.1"
        xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
>
    <name>RustorePay Plugin</name>
    <description>Cordova plugin for rustore-pay</description>
    <js-module src="www/rustore-pay.js" name="RustorePay">
        <clobbers target="RustorePay" />
    </js-module>

    <engines>
        <engine name="cordova" version=">=12.0" />
        <engine name="cordova-android" version=">=10.1.2" />
        <engine name="cordova-ios" version=">=7.0.1" />
    </engines>

    <platform name="android">

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="RustorePayPlugin">
                <param name="android-package" value="com.maximnara.rustore.pay.RustorePayPlugin" />
            </feature>
            <preference name="android-gradleVersion" value="8.13" />
            <preference name="android-minSdkVersion" value="23" />
            <preference name="GradlePluginKotlinEnabled" value="true" />
        </config-file>

        <!-- Add your Android permissions here -->
        <!--<config-file target="AndroidManifest.xml" parent="/manifest">-->
            <!--<uses-permission android:name="android.permission.INTERNET" />-->
        <!--</config-file>-->

        <!-- Add your Android application config here -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <meta-data android:name="console_app_id_key" android:value="64612543" />
        </config-file>

        <source-file src="src/android" target-dir="java/com/maximnara/rustore/pay" />
        
        <!-- Add your gradle dependencies here -->
        <framework src="src/android/rustore-pay.gradle" custom="true" type="gradleReference" />

        <!-- Add your framework dependencies here -->
        <!--<framework src="com.android.support:support-v4:+" />-->

        <!-- Add your resource files here -->
        <!--<resource-file src="src/android/example.xml" target="res/values/example.xml" />-->
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="RustorePayPlugin">
                <param name="ios-package" value="RustorePayPlugin" />
            </feature>
            <preference name="SwiftVersion" value="5.8" />
            <preference name="deployment-target" value="13.0" />
            <preference name="IPHONEOS_DEPLOYMENT_TARGET" value="13.0" />
            <preference name="ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES" value="YES" />
        </config-file>

        <!-- Add your iOS source files here -->
        <source-file src="src/ios/RustorePayPlugin.swift" />
        <header-file src="src/ios/RustorePayPlugin.h" />

        <!-- Add your CocoaPods dependencies here -->
        <!--<podspec>-->
            <!--<config>-->
                <!--<source url="https://cdn.cocoapods.org/"/>-->
            <!--</config>-->
            <!--<pods use-frameworks="true">-->
                <!--<pod name="ExampleSDK" spec="~> 1.0.0" />-->
            <!--</pods>-->
        <!--</podspec>-->

        <!-- Add your iOS frameworks here -->
        <!--<framework src="ExampleSDK.framework" />-->
    </platform>
</plugin>
